{
  "compilerOptions": {
    "target": "ES2022", "module": "Node16", "moduleResolution": "Node16",
    "strict": true, "esModuleInterop": true, "skipLibCheck": true,
    "lib": ["ES2022", "DOM"], "types": ["node", "vscode"],
    "baseUrl": ".", "paths": { "@webview-dev/helper": ["packages/helper/src/index.ts"], "@webview-dev/helper/*": ["packages/helper/src/*"] }
  },
  "include": ["packages/**/*.ts", "examples/**/*.ts", "tests/**/*.ts"],
  "exclude": ["**/dist", "**/node_modules", "artifacts", ".vscode-test"]
}
